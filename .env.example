# PostgreSQL connection string supplied by your database provider.
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Table or view containing: wallet (text) and total_deposited_usd (numeric).
# A view is useful when deposits are stored across several tables.
LEADERBOARD_SOURCE=leaderboard

PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
DB_POOL_MAX=10
# Set to true only when your hosted PostgreSQL provider requires SSL.
DB_SSL=false
